# Copy to .env for local development. Never commit the real .env file.
# Values below are examples and must be adjusted when application services are implemented.

# PostgreSQL
POSTGRES_DB=pulsecheck
POSTGRES_USER=pulsecheck
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql://pulsecheck:change-me-for-local-development@db:5432/pulsecheck

# API
API_HOST=0.0.0.0
API_PORT=8000

# Monitoring
CHECK_INTERVAL_SECONDS=60
CHECK_TIMEOUT_SECONDS=10
